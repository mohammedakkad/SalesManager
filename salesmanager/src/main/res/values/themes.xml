<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Light theme window background matches LightBackground = 0xFFF2F4F7.
        Setting it explicitly prevents the system from showing white while the
        Compose layout is being measured on first draw.
    -->
    <style name="Theme.SalesManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F4F7</item>
        <item name="android:colorBackground">#F2F4F7</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
